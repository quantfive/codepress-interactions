{
  "name": "@codepress/interactions-react",
  "version": "0.1.0",
  "description": "Optional React lifecycle adapter for interaction evidence",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codepress/interactions-browser": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quantfive/codepress-interactions.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
