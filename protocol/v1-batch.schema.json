{
  "$defs": {
    "Data": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Id"
        },
        "surface": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "action": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "route_template": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Template"
        },
        "feedback_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Type"
        },
        "trace_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "phase": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "running",
                "succeeded",
                "failed",
                "cancelled",
                "pending",
                "completed",
                "error",
                "abandoned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "duration_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "sdk_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdk Version"
        }
      },
      "title": "Data",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "interaction_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interaction Id"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "source": {
          "enum": [
            "browser",
            "server",
            "worker"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_instance_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Instance Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ms"
        },
        "type": {
          "enum": [
            "interaction.started",
            "ui.state.changed",
            "request.started",
            "request.completed",
            "operation.started",
            "operation.phase",
            "operation.completed",
            "capture.interrupted",
            "capture.events_dropped"
          ],
          "title": "Type",
          "type": "string"
        },
        "attribution": {
          "enum": [
            "explicit",
            "inferred",
            "unknown"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/Data"
        }
      },
      "required": [
        "event_id",
        "schema_version",
        "source",
        "source_instance_id",
        "sequence",
        "occurred_at",
        "type",
        "attribution",
        "data"
      ],
      "title": "Event",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "batch_id",
    "schema_version",
    "events"
  ],
  "title": "Batch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantfive/codepress-interactions/blob/main/protocol/v1-batch.schema.json",
  "description": "Generated from hosted v1 contract. In addition: operation.* events require operation_id; ui.* events cannot have operation_id. Credential authority is enforced by ingestion."
}
